NEXT_PUBLIC_VENICE_API_KEY = your_venice_api_key

# NEXT_PUBLIC_BYPASS_PAYWALL and NEXT_PUBLIC_ADMIN_TOOLS are retired.
# Promote a verified account via auth:promote-admin.

# Server-only SQL/auth configuration. See docs/workflow-catalog.md for migration/setup.
DATABASE_URL=
BETTER_AUTH_URL=http://localhost:4000
# Generate a random secret of at least 32 characters; never commit it.
BETTER_AUTH_SECRET=
AUTH_ALLOW_SIGNUP=false
# Local SMTP capture (e.g. Mailpit) can use 127.0.0.1:1025. Vendor selection is deferred.
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Admin-only workflow authoring beta. No default model: choose/verify a Venice text model
# supporting JSON output and review its price/privacy classification before enabling.
WORKFLOW_WIZARD_ENABLED=false
WORKFLOW_WIZARD_MODEL=

# Serper.dev (Goon Game's "Serper" image-search source — see src/app/api/serper/image-search).
# Free key at https://serper.dev — 2,500 free searches, then paid.
SERPER_API_KEY=


# NOWPayments (see docs/account-billing.md). Keep enrollment disabled until the recurring
# payment association is confirmed/implemented and all launch gates pass. This flag alone
# does NOT enable automatic payment association.
NOWPAYMENTS_ENROLLMENT_ENABLED=false
# Dashboard: https://account.nowpayments.io/dashboard -> Payment settings / API keys.
# Server-only — never prefix these with NEXT_PUBLIC_.
NOWPAYMENTS_API_KEY=
# Merchant credentials for short-lived provider bearer authentication; NOT a customer login.
NOWPAYMENTS_ACCOUNT_EMAIL=
NOWPAYMENTS_ACCOUNT_PASSWORD=
# Store settings -> Instant Payment Notifications -> secret key.
NOWPAYMENTS_IPN_SECRET=
# Publicly reachable HTTPS URL NOWPayments will POST payment updates to. Must be a real internet
# address (not localhost); the application checks the exact path /api/nowpayments/ipn.
NOWPAYMENTS_IPN_CALLBACK_URL=https://your-domain.example.com/api/nowpayments/ipn
# Configure/verify the USD45/90-day plan in the operator-owned provider dashboard.
# The public setup-plan route is retired. Plan terms/callback are checked before enrollment.
NOWPAYMENTS_PLAN_ID=
